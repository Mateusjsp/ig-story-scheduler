# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key

# URL do image-service (FastAPI). Local: http://localhost:8000
IMAGE_SERVICE_URL=http://localhost:8000

# Mesmo valor de SERVICE_SHARED_SECRET do image-service.
SERVICE_SHARED_SECRET=

# Chave de cifragem do token do Instagram (AES-256-GCM). DEVE ser idêntica à do
# image-service/.env. Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENC_KEY=

# Instagram OAuth (Meta app — login do Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# URL pública do painel (pro redirect do OAuth). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
